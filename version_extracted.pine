fm_builder_price(fm_builder_setup.cisd_level)
)

else if na(fm_builder_entry_mid)
fm_builder_direction := fm_builder_is_bull ? "LONG BUILDING" : "SHORT
BUILDING"
fm_builder_phase := "CISD CONFIRMED"
fm_builder_stage := 3
fm_builder_next := "Waiting for this model's C3/C4 entry zone."

else
bool fm_builder_has_valid_tp = (
not na(fm_builder_tp1) or
not na(fm_builder_tp2)
)

fm_builder_direction := (
fm_builder_is_bull
? "LONG READY"
: "SHORT READY"
