settings.liq_width))

// ==== LAYER 2: PROJECTIONS - SKIP if invalid ====
if not setup.is_invalid and settings.proj_show and setup.cisd_triggered and not
na(setup.proj_anchor_1) and not na(setup.proj_anchor_0)
proj_line_style = LineStyle(settings.proj_style)
proj_label_sz = LabelSize(settings.proj_label_size)
ﬂoat proj_range = setup.proj_anchor_1 - setup.proj_anchor_0

for dv = 0 to proj_deviations.size() - 1
dev = proj_deviations.get(dv)
ﬂoat price = na
if is_bull
price := setup.proj_anchor_0 - (math.abs(proj_range) * dev)
else
