//
======================================================================
======
// Helper Functions
//
======================================================================
======

LineStyle(string style) =>
switch style
'Dashed' => line.style_dashed
'Dotted' => line.style_dotted
=> line.style_solid

LabelSize(string lbl_size) =>
switch lbl_size
'Tiny' => size.tiny
'Normal' => size.normal
'Large' => size.large
'Huge' => size.huge
=> size.small

DayofWeek(int index) =>
switch
index == 1 => 'M'
index == 2 => 'T'
index == 3 => 'W'
index == 4 => 'T'
index == 5 => 'F'

index == 6 => 'S'
index == 7 => 'S'
na(index) => ''

ValidTimeframe(string HTF) =>
// Session-based modes are always valid
if str.startswith(HTF, "SESSION_")
true
else if timeframe.in_seconds(HTF) >= timeframe.in_seconds('D') and
timeframe.in_seconds(HTF) > timeframe.in_seconds()
true
else
n1 = timeframe.in_seconds()
n2 = timeframe.in_seconds(HTF)
n1 < n2 and math.round(n2 / n1) == n2 / n1

RemainingTime(string HTF) =>
// Session-based modes: calculate remaining time based on session duration
if str.startswith(HTF, "SESSION_") and barstate.isrealtime
int duration_seconds = getQuarterlyDurationSeconds(HTF)
// Estimate remaining time: duration minus time since last session change
int elapsed = (timenow - time) / 1000
int remaining = math.max(0, duration_seconds - (elapsed % duration_seconds))
hours = math.ﬂoor(remaining / 3600)
minutes = math.ﬂoor((remaining - hours * 3600) / 60)
seconds = remaining - hours * 3600 - minutes * 60
str.tostring(hours, '00') + ':' + str.tostring(minutes, '00') + ':' + str.tostring(seconds,
'00')
else if barstate.isrealtime and not str.startswith(HTF, "SESSION_")

timeRemaining = (time_close(HTF) - timenow) / 1000
days = math.ﬂoor(timeRemaining / 86400)
hours = math.ﬂoor((timeRemaining - days * 86400) / 3600)
minutes = math.ﬂoor((timeRemaining - days * 86400 - hours * 3600) / 60)
seconds = math.ﬂoor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)
r = str.tostring(seconds, '00')
if minutes > 0 or hours > 0 or days > 0
r := str.tostring(minutes, '00') + ':' + r
if hours > 0 or days > 0
r := str.tostring(hours, '00') + ':' + r
if days > 0
r := str.tostring(days) + 'D ' + r
r
else
'n/a'

HTFName(string HTF) =>
// Handle session-based modes with descriptive names
if HTF == "SESSION_MICRO"
"Micro Cycle"
else if HTF == "SESSION_90"
"Quarterly"
else if HTF == "SESSION_6H"
"Sessions"
else
formatted = HTF
seconds = timeframe.in_seconds(HTF)
if seconds < 60

formatted := str.tostring(seconds) + 's'
else if seconds / 60 < 60
formatted := str.tostring(seconds / 60) + 'm'
else if seconds / 60 / 60 < 24
formatted := str.tostring(seconds / 60 / 60) + 'H'
formatted

// Get current chart timeframe formatted
LTFName() =>
seconds = timeframe.in_seconds()
result = timeframe.period
if seconds < 60
result := str.tostring(seconds) + 's'
else if seconds < 3600
result := str.tostring(seconds / 60) + 'm'
else if seconds < 86400
result := str.tostring(seconds / 3600) + 'H'
result

// Build alert message: "LTF-HTF TICKER: [Potential] Bullish/Bearish <name>"
BuildAlertMessage(string htf, bool is_bullish, bool is_potential, string name) =>
string ltf = LTFName()
string htf_name = HTFName(htf)
string direction = is_bullish ? "Bullish" : "Bearish"
string potential = is_potential ? "Potential " : ""
str.format("{0}-{1} {2}: {3}{4} {5}", ltf, htf_name, syminfo.ticker, potential, direction,
name)

CandleSetHigh(array<Candle> candles, ﬂoat h) =>
ﬂoat _h = h
for c in candles
if c.h > _h
_h := c.h
_h

CandleSetLow(array<Candle> candles, ﬂoat l) =>
ﬂoat _l = l
for c in candles
if c.l < _l
_l := c.l
_l
// CISD body area (bodies only) from CISD start through C2 extreme — returns [body_lo,
body_hi, body_mid]
GetCisdBodyRange(int cisd_start_idx, int extreme_bar_idx) =>
ﬂoat body_hi = na
ﬂoat body_lo = na
if not na(cisd_start_idx) and not na(extreme_bar_idx)
int oh_a = bar_index - extreme_bar_idx
int oh_b = bar_index - cisd_start_idx
int lo_oh = math.max(0, math.min(oh_a, oh_b))
int hi_oh = math.min(math.max(oh_a, oh_b), 500)
if lo_oh <= hi_oh
for i = lo_oh to hi_oh
ﬂoat bt = math.max(open[i], close[i])
ﬂoat bb = math.min(open[i], close[i])
body_hi := na(body_hi) ? bt : math.max(body_hi, bt)

body_lo := na(body_lo) ? bb : math.min(body_lo, bb)
ﬂoat body_mid = not na(body_hi) and not na(body_lo) ? (body_hi + body_lo) / 2.0 : na
[body_lo, body_hi, body_mid]

// Set C3 entry zone once: if C2 mid inside CISD body → C2 mid↔body mid; else C2
mid↔C3 open
TrySetEntryZoneC3(Setup setup) =>
if settings.entry_zone_show and not setup.ez_c3_set and not setup.is_invalid and
setup.is_post_c2 and setup.cisd_triggered and not na(setup.c2_mid) and not
na(setup.c3_open) and not na(setup.cisd_start_idx) and not na(setup.extreme_bar_idx)
[body_lo, body_hi, body_mid] = GetCisdBodyRange(setup.cisd_start_idx,
setup.extreme_bar_idx)
if not na(body_lo) and not na(body_hi) and not na(body_mid)
ﬂoat c2m = setup.c2_mid
bool inside = c2m >= body_lo and c2m <= body_hi
ﬂoat y2 = inside ? body_mid : setup.c3_open
setup.ez_c3_top := math.max(c2m, y2)
setup.ez_c3_bot := math.min(c2m, y2)
setup.ez_c3_set := true
setup

// At C3 close / C4 open: always store C3 mid + C4 span (for Previous EQ); entry-zone
box only if enabled
TrySetEntryZoneC4(Setup setup, ﬂoat c3_h, ﬂoat c3_l, ﬂoat c4_open_price, int
left_time, int right_time) =>
if not setup.is_invalid and not na(c3_h) and not na(c3_l) and not na(c4_open_price)
ﬂoat c3m = (c3_h + c3_l) / 2.0
setup.c3_mid := c3m
setup.c3_extreme := setup.is_bullish ? c3_l : c3_h
setup.c4_open := c4_open_price

setup.ez_c4_left_time := left_time
setup.ez_c4_right_time := right_time
if settings.entry_zone_show and not setup.ez_c4_set
setup.ez_c4_top := math.max(c3m, c4_open_price)
setup.ez_c4_bot := math.min(c3m, c4_open_price)
setup.ez_c4_set := true
setup.ez_c4_invalid := false
setup

// Right edge for entry zone / EQ: grows with each LTF bar; once period ends, locks at
ﬁnal edge
EntryZoneRight(int locked_right) =>
int developing = time_close
na(locked_right) ? developing : (time >= locked_right ? locked_right :
math.min(developing, locked_right))

// Chart Previous EQ on for this setup? (On Chart or Both)
ShowChartEQ() =>
prev_eq_show and (drawings_type == 'On Chart' or drawings_type == 'Both')

// HTF projection Previous EQ on for this setup? (HTF candle or Both)
ShowHtfEQ() =>
prev_eq_show and (drawings_type == 'HTF candle' or drawings_type == 'Both')

// Find array index of HTF candle by o_idx (-1 if not in projection)
FindCandleIndex(array<Candle> candles, int o_idx) =>
int found = -1
if not na(o_idx) and candles.size() > 0
for i = 0 to candles.size() - 1

if candles.get(i).o_idx == o_idx
found := i
break
found

// FindCISDLevel traces back from the extreme bar to ﬁnd consecutive opposing
candles
// Returns [cisd_level, cisd_start_idx]
// extreme_bar_idx: the bar index where lowest low (bullish) or highest high (bearish)
occurred
// bias: 1 for bullish candles (bearish setup), -1 for bearish candles (bullish setup)
FindCISDLevel(int extreme_bar_idx, int bias) =>
int ohset = bar_index - extreme_bar_idx // How many bars ago the extreme occurred

ﬂoat cisd_price = na
int cisd_idx = na
bool found_ﬁrst = false

// Start from the extreme bar itself and trace back
for i = ohset to math.min(ohset + 500, bar_index)
ﬂoat c_open = open[i]
ﬂoat c_close = close[i]
int candle_attitude = c_close > c_open ? 1 : c_close < c_open ? -1 : 0

if candle_attitude == 0
continue

if not found_ﬁrst
if candle_attitude == bias

found_ﬁrst := true
cisd_price := c_open
cisd_idx := bar_index - i
else
if candle_attitude != bias
break
cisd_price := c_open
cisd_idx := bar_index - i

[cisd_price, cisd_idx]

// ——— IC-CISD (rebuild) ———
// - Level = open of the starting opposite candle; does not move onto later same-side
candles
// - Conﬁrm on later body break through that open
// - Mark only if a 3-candle swing exists (middle beyond both neighbors). Start may be
that middle; close-through may be the right.
// - Dot = highest swing wick (bear) / lowest swing wick (bull) among those middles
