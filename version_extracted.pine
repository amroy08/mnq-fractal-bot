method clear(DrawingBin bin) =>
for ln in bin.lines
ln.delete()
for bx in bin.boxes
bx.delete()
for lbl in bin.labels
lbl.delete()
bin.lines.clear()
bin.boxes.clear()
bin.labels.clear()

