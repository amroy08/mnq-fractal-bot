18,
"Guide line length (bars)",
minval = 5,
maxval = 100,
group = fm_builder_group
)

fm_builder_price(ﬂoat value) =>
na(value) ? "-" : str.tostring(value, format.mintick)

fm_builder_zone(ﬂoat bottom, ﬂoat top) =>
na(bottom) or na(top) ? "-" : fm_builder_price(bottom) + " - " + fm_builder_price(top)

//
======================================================================
======
// 1. PICK THE FRACTAL MODEL SETUP TO DISPLAY
//
======================================================================
======

bool fm_builder_live_bull = htf.has_live_bullish
bool fm_builder_live_bear = htf.has_live_bearish

Setup fm_builder_setup = na
bool fm_builder_has_setup = false
bool fm_builder_both_sides = false

if fm_builder_live_bull and fm_builder_live_bear
Setup fm_builder_bull_candidate = htf.live_bullish
Setup fm_builder_bear_candidate = htf.live_bearish

int fm_builder_bull_score = fm_builder_bull_candidate.cisd_triggered ? 3 :
fm_builder_bull_candidate.is_conﬁrmed ? 2 : 1
int fm_builder_bear_score = fm_builder_bear_candidate.cisd_triggered ? 3 :
fm_builder_bear_candidate.is_conﬁrmed ? 2 : 1

if fm_builder_bull_score > fm_builder_bear_score
fm_builder_setup := fm_builder_bull_candidate
fm_builder_has_setup := true
else if fm_builder_bear_score > fm_builder_bull_score
fm_builder_setup := fm_builder_bear_candidate
fm_builder_has_setup := true
else
fm_builder_both_sides := true

else if fm_builder_live_bull
fm_builder_setup := htf.live_bullish
fm_builder_has_setup := true

else if fm_builder_live_bear
fm_builder_setup := htf.live_bearish
fm_builder_has_setup := true

// When C3 closes the original model can move the setup from "live" into history.
// Keep the newest setup visible while its C3/C4 entry window is still active.
if not fm_builder_has_setup and not fm_builder_both_sides and htf.setups.size() > 0
Setup fm_builder_recent = htf.setups.ﬁrst()

bool fm_builder_recent_c3_active = (
fm_builder_recent.ez_c3_set and
(
na(fm_builder_recent.ez_c3_right_time) or
time < fm_builder_recent.ez_c3_right_time
)
)

bool fm_builder_recent_c4_active = (
fm_builder_recent.ez_c4_set and
not fm_builder_recent.ez_c4_invalid and
(
na(fm_builder_recent.ez_c4_right_time) or
time < fm_builder_recent.ez_c4_right_time
)
)

if not fm_builder_recent.is_invalid and (fm_builder_recent_c3_active or
fm_builder_recent_c4_active)

fm_builder_setup := fm_builder_recent
fm_builder_has_setup := true

//
======================================================================
======
// 2. TRANSLATE THE MODEL INTO SIMPLE STATUS
//
======================================================================
======

bool fm_builder_is_bull = false
bool fm_builder_ready = false

int fm_builder_stage = 0

string fm_builder_direction = "NO ACTIVE SETUP"
string fm_builder_phase = "WAITING"
string fm_builder_sweep_text = "-"
string fm_builder_cisd_text = "-"
string fm_builder_smt_text = "-"
string fm_builder_entry_name = "-"
string fm_builder_entry_zone_text = "-"
string fm_builder_next = "Waiting for the Fractal Model to detect a live sweep."

ﬂoat fm_builder_sweep_price = na
ﬂoat fm_builder_cisd_level = na
ﬂoat fm_builder_entry_bottom = na
ﬂoat fm_builder_entry_top = na

ﬂoat fm_builder_entry_mid = na
ﬂoat fm_builder_stop = na
ﬂoat fm_builder_tp1 = na
ﬂoat fm_builder_tp2 = na

if fm_builder_both_sides
fm_builder_direction := "BOTH SIDES BUILDING"
fm_builder_phase := "BULLISH + BEARISH LIVE SWEEP"
fm_builder_stage := 1
fm_builder_next := "WAIT. Let one Fractal Model setup advance ﬁrst."

else if fm_builder_has_setup
fm_builder_is_bull := fm_builder_setup.is_bullish
fm_builder_sweep_price := fm_builder_setup.sweep_price
fm_builder_cisd_level := fm_builder_setup.cisd_level

fm_builder_sweep_text := (
fm_builder_setup.is_conﬁrmed
? "CONFIRMED @ " + fm_builder_price(fm_builder_setup.sweep_price)
: "WICKED @ " + fm_builder_price(fm_builder_setup.sweep_price)
)

fm_builder_cisd_text := (
not fm_builder_setup.has_cisd
? "SEARCHING"
: fm_builder_setup.cisd_triggered
? "CONFIRMED @ " + fm_builder_price(fm_builder_setup.cisd_level)
:(

fm_builder_is_bull
? "WAIT CLOSE ABOVE " + fm_builder_price(fm_builder_setup.cisd_level)
: "WAIT CLOSE BELOW " + fm_builder_price(fm_builder_setup.cisd_level)
)
)

fm_builder_smt_text := (
fm_builder_setup.has_smt
? "YES - " + fm_builder_setup.smt_symbol
: "NO / NOT DETECTED"
)

// Prefer C4 when the Fractal Model has already created a valid C4 zone.
if fm_builder_setup.ez_c4_set and not fm_builder_setup.ez_c4_invalid
fm_builder_entry_name := "C4 ENTRY ZONE"
fm_builder_entry_bottom := fm_builder_setup.ez_c4_bot
fm_builder_entry_top := fm_builder_setup.ez_c4_top

else if fm_builder_setup.ez_c3_set
fm_builder_entry_name := "C3 ENTRY ZONE"
fm_builder_entry_bottom := fm_builder_setup.ez_c3_bot
fm_builder_entry_top := fm_builder_setup.ez_c3_top

fm_builder_entry_zone_text := fm_builder_zone(
fm_builder_entry_bottom,
fm_builder_entry_top
)

if not na(fm_builder_entry_bottom) and not na(fm_builder_entry_top)
fm_builder_entry_mid := math.round_to_mintick(
(fm_builder_entry_bottom + fm_builder_entry_top) / 2.0
)

// SL guide = beyond the Fractal Model's C2/developing extreme.
ﬂoat fm_builder_model_extreme = (
not na(fm_builder_setup.c2_extreme)
? fm_builder_setup.c2_extreme
: fm_builder_setup.tracked_extreme
)

if not na(fm_builder_model_extreme)
fm_builder_stop := math.round_to_mintick(
fm_builder_is_bull
? fm_builder_model_extreme - fm_builder_sl_ticks * syminfo.mintick
: fm_builder_model_extreme + fm_builder_sl_ticks * syminfo.mintick
)

// TP guides = this Fractal Model's own formation-liquidity levels.
//
======================================================================
==
// TP GUIDES - ONLY SHOW TARGETS ON THE PROFITABLE SIDE OF ENTRY
//
======================================================================
==

//
======================================================================
==
// TP GUIDES - SAFE + DIRECTION VALIDATED
//
// Uses ONLY the Fractal Model's C1 / C0 formation liquidity.
//
// LONG:
// target must be ABOVE entry.
//
// SHORT:
// target must be BELOW entry.
//
// IMPORTANT:
// fm_builder_setup can be na when there is no active setup,
// so we access its ﬁelds ONLY when fm_builder_has_setup = true.
//
======================================================================
==

ﬂoat fm_builder_raw_c1 = na
ﬂoat fm_builder_raw_c0 = na

// Reset targets every bar
fm_builder_tp1 := na
fm_builder_tp2 := na

// Only read the Setup object when one actually exists

if fm_builder_has_setup

fm_builder_raw_c1 :=
fm_builder_setup.liq_c1_price

fm_builder_raw_c0 :=
fm_builder_setup.liq_c0_price

// Only validate targets once the model has an entry guide
if not na(fm_builder_entry_mid)

// ================================================================
// LONG
// Targets must be ABOVE entry
// ================================================================

if fm_builder_is_bull

if (
not na(fm_builder_raw_c1) and
fm_builder_raw_c1 > fm_builder_entry_mid
)

fm_builder_tp1 :=
fm_builder_raw_c1

if (
not na(fm_builder_raw_c0) and
fm_builder_raw_c0 > fm_builder_entry_mid
)

fm_builder_tp2 :=
fm_builder_raw_c0

// ================================================================
// SHORT
// Targets must be BELOW entry
// ================================================================

else

if (
not na(fm_builder_raw_c1) and
fm_builder_raw_c1 < fm_builder_entry_mid
)

fm_builder_tp1 :=
fm_builder_raw_c1

if (
not na(fm_builder_raw_c0) and
fm_builder_raw_c0 < fm_builder_entry_mid

)

fm_builder_tp2 :=
fm_builder_raw_c0

if fm_builder_setup.is_invalid
fm_builder_direction := fm_builder_is_bull ? "LONG CANCELLED" : "SHORT
CANCELLED"
fm_builder_phase := "MODEL INVALIDATED"
fm_builder_stage := 0
fm_builder_next := "Wait for a new Fractal Model setup."

else if not fm_builder_setup.is_conﬁrmed
fm_builder_direction := fm_builder_is_bull ? "POTENTIAL LONG" : "POTENTIAL
SHORT"
fm_builder_phase := "SWEEP BUILDING"
fm_builder_stage := 1
fm_builder_next := (
fm_builder_is_bull
? "Need price to CLOSE BACK ABOVE the swept HTF low."
: "Need price to CLOSE BACK BELOW the swept HTF high."
)

else if not fm_builder_setup.cisd_triggered
fm_builder_direction := fm_builder_is_bull ? "LONG BUILDING" : "SHORT
BUILDING"
fm_builder_phase := "SWEEP CONFIRMED | WAIT CISD"
fm_builder_stage := 2
fm_builder_next := (

not fm_builder_setup.has_cisd
? "The Fractal Model is still locating CISD."
: fm_builder_is_bull
? "Need body close ABOVE CISD " +
fm_builder_price(fm_builder_setup.cisd_level)
