else
fm_builder_state := fm_builder_ready ? 4 : 2

var int fm_builder_previous_state = 0

bool fm_builder_new_long = (
(fm_builder_state == 1 or fm_builder_state == 3) and
not (fm_builder_previous_state == 1 or fm_builder_previous_state == 3)

)

bool fm_builder_new_short = (
(fm_builder_state == 2 or fm_builder_state == 4) and
not (fm_builder_previous_state == 2 or fm_builder_previous_state == 4)
)

bool fm_builder_long_ready_now = (
fm_builder_state == 3 and
fm_builder_previous_state != 3
)

bool fm_builder_short_ready_now = (
fm_builder_state == 4 and
fm_builder_previous_state != 4
)

alertcondition(
fm_builder_new_long,
"Fractal Model - LONG BUILDING",
"Fractal Model: POTENTIAL LONG / LONG BUILDING. Check the beginner panel."
)

alertcondition(
fm_builder_new_short,
"Fractal Model - SHORT BUILDING",
"Fractal Model: POTENTIAL SHORT / SHORT BUILDING. Check the beginner panel."
)

alertcondition(
fm_builder_long_ready_now,
"Fractal Model - LONG READY",
"Fractal Model: LONG READY. Its C3/C4 entry zone is active."
)

alertcondition(
fm_builder_short_ready_now,
"Fractal Model - SHORT READY",
"Fractal Model: SHORT READY. Its C3/C4 entry zone is active."
)

if fm_builder_alerts and barstate.isrealtime
if fm_builder_new_long
alert(
"FRACTAL MODEL: LONG BUILDING | Sweep " +
fm_builder_sweep_text +
" | CISD " +
fm_builder_cisd_text,
alert.freq_once_per_bar
)

if fm_builder_new_short
alert(
"FRACTAL MODEL: SHORT BUILDING | Sweep " +
fm_builder_sweep_text +
" | CISD " +

fm_builder_cisd_text,
alert.freq_once_per_bar
)

if fm_builder_long_ready_now
alert(
"FRACTAL MODEL: LONG READY | " +
fm_builder_entry_name +
""+
fm_builder_entry_zone_text +
" | Entry guide " +
fm_builder_price(fm_builder_entry_mid) +
" | SL " +
fm_builder_price(fm_builder_stop),
alert.freq_once_per_bar
)

if fm_builder_short_ready_now
alert(
"FRACTAL MODEL: SHORT READY | " +
fm_builder_entry_name +
""+
fm_builder_entry_zone_text +
" | Entry guide " +
fm_builder_price(fm_builder_entry_mid) +
" | SL " +
fm_builder_price(fm_builder_stop),
alert.freq_once_per_bar

)

fm_builder_previous_state := fm_builder_state

//
======================================================================
======
// 6. PYTHON PARITY EXPORT
//
======================================================================
======
//
// PURPOSE:
// Export the Fractal Model's exact trade-plan values so they can be compared
// candle-by-candle against the Python FractalEngine.
//
// THIS DOES NOT:
// - place orders
// - change setup logic
// - change C3/C4 logic
// - change SL
// - change TP
// - change alerts
//
// Values only appear when a NEW bot-ready model becomes available.
//
======================================================================
======

// ---------------------------------------------------------------------------// BOT-READY STATE
//
// Python only treats a setup as tradable when we have:
//
// 1. Entry
// 2. Stop
// 3. At least one valid formation-liquidity target
// ----------------------------------------------------------------------------

bool fm_parity_bot_ready = (
fm_builder_ready and
not na(fm_builder_entry_mid) and
not na(fm_builder_stop) and
(
not na(fm_builder_tp1) or
not na(fm_builder_tp2)
)
)

// ---------------------------------------------------------------------------// DIRECTION
//
// +1 = LONG
// -1 = SHORT
// ----------------------------------------------------------------------------

ﬂoat fm_parity_direction = (
fm_builder_is_bull
? 1.0
: -1.0
)

// ---------------------------------------------------------------------------// ENTRY ZONE
//
// 3 = C3
// 4 = C4
// ----------------------------------------------------------------------------

ﬂoat fm_parity_entry_zone = (
fm_builder_entry_name == "C4 ENTRY ZONE"
? 4.0
: 3.0
)

// ---------------------------------------------------------------------------// PREFERRED TARGET
//
// Python prefers C1 when available.
// If C1 is unavailable, use C0.
// ----------------------------------------------------------------------------

ﬂoat fm_parity_preferred_target = (
not na(fm_builder_tp1)
? fm_builder_tp1
: fm_builder_tp2
)

// ---------------------------------------------------------------------------// UNIQUE SIGNAL KEY
//
// Prevent the same ready setup from being exported on every 5-minute candle.
//
// A C3 setup and its later C4 setup intentionally have diherent keys.
// ----------------------------------------------------------------------------

string fm_parity_key = (
fm_parity_bot_ready
?(
(
fm_builder_is_bull
? "L:"
: "S:"
)+
fm_builder_entry_name +
":" +
str.tostring(
fm_builder_entry_mid,
format.mintick

)+
":" +
str.tostring(
fm_builder_stop,
format.mintick
)
)
: ""
)

var string fm_parity_last_key = ""

bool fm_parity_new_signal = (
fm_parity_bot_ready and
fm_parity_key != fm_parity_last_key
)

if fm_parity_new_signal
fm_parity_last_key := fm_parity_key

// ---------------------------------------------------------------------------// RESET KEY
//
// Once there is no active ready model, allow a future setup with the same
// numerical prices to be exported again.
// ----------------------------------------------------------------------------

if not fm_parity_bot_ready
fm_parity_last_key := ""

//
======================================================================
======
// EXPORT SERIES
//
// display.data_window keeps these oh the visible price chart while allowing
// us to retrieve the values from TradingView chart data.
//
======================================================================
======

plot(
fm_parity_new_signal ? 1 : na,
title = "PARITY Signal",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_parity_direction : na,
title = "PARITY Direction",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_parity_entry_zone : na,

title = "PARITY Entry Zone",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_builder_entry_mid : na,
title = "PARITY Entry",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_builder_stop : na,
title = "PARITY Stop",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_parity_preferred_target : na,
title = "PARITY Preferred Target",
display = display.data_window
)

// ---------------------------------------------------------------------------// EXTRA DIAGNOSTIC FIELDS
//
// These aren't needed for the ﬁrst parity percentage, but if something
// doesn't match they tell us WHY.

// ----------------------------------------------------------------------------

plot(
fm_parity_new_signal ? fm_builder_sweep_price : na,
title = "PARITY Sweep",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_builder_cisd_level : na,
title = "PARITY CISD",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_builder_tp1 : na,
title = "PARITY TP C1",
display = display.data_window
)

plot(
fm_parity_new_signal ? fm_builder_tp2 : na,
title = "PARITY TP C0",
display = display.data_window
)
//
======================================================================
======

//
======================================================================
======
// FINAL FREE PARITY LOG - C3 BOT-READY SIGNALS
//
======================================================================
======
//
// One log per unique C3 setup.
//
// A setup is exported only when:
//
// 1. Fractal Model is READY
// 2. C3 is the active entry zone
// 3. Entry exists
// 4. Stop exists
// 5. At least one valid C1/C0 target exists
//
// This matches the Python bot-ready requirement.
//
======================================================================
======

// -------------------------------------------------------------------// UNIQUE C3 ID
//
// ez_c3_left_time = exact time that this model's C3 began.
// --------------------------------------------------------------------

int fm_parity_c3_id = na

if fm_builder_has_setup
fm_parity_c3_id := fm_builder_setup.ez_c3_left_time

// -------------------------------------------------------------------// BOT READY
// --------------------------------------------------------------------

bool fm_parity_c3_bot_ready = (
fm_builder_ready and
fm_builder_entry_name == "C3 ENTRY ZONE" and
not na(fm_parity_c3_id) and
not na(fm_builder_entry_mid) and
not na(fm_builder_stop) and
(
not na(fm_builder_tp1) or
not na(fm_builder_tp2)
)
)

// -------------------------------------------------------------------// DIRECTION
//
// +1 LONG
// -1 SHORT

// --------------------------------------------------------------------

ﬂoat fm_parity_c3_direction = (
fm_builder_is_bull
? 1.0
: -1.0
)

// -------------------------------------------------------------------// PREFERRED TARGET
//
// Same rule as Python:
// C1 ﬁrst, otherwise C0.
// --------------------------------------------------------------------

ﬂoat fm_parity_c3_target = (
not na(fm_builder_tp1)
? fm_builder_tp1
: fm_builder_tp2
)

// -------------------------------------------------------------------// STOP DISTANCE
//
// Useful later when we analyze the <= 50 point ﬁlter.
// --------------------------------------------------------------------

ﬂoat fm_parity_c3_stop_points = (
math.abs(
fm_builder_entry_mid fm_builder_stop
)
)

// -------------------------------------------------------------------// DEDUPLICATE
//
// The same C3 can remain READY for many 5m candles.
// Export it only once.
// --------------------------------------------------------------------

var int fm_parity_last_c3_id = na

bool fm_parity_new_c3 = (
fm_parity_c3_bot_ready and
(
na(fm_parity_last_c3_id) or
fm_parity_c3_id != fm_parity_last_c3_id
)
)

// --------------------------------------------------------------------

// LOG
// --------------------------------------------------------------------

if fm_parity_new_c3

log.info(
"PARITY|time={0}|c3time={1}|direction={2}|zone=3|entry={3}|stop={4}|target={5}|stopPoi
nts={6}",
time,
fm_parity_c3_id,
fm_parity_c3_direction,
fm_builder_entry_mid,
fm_builder_stop,
fm_parity_c3_target,
fm_parity_c3_stop_points
)

fm_parity_last_c3_id := (
fm_parity_c3_id
)

