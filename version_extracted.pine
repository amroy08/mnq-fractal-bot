textcolor = settings.htf_label_color, style = label.style_label_up, size =
settings.htf_label_size))
candleSet

method DrawTrace(CandleSet candleSet, int ohset) =>
if settings.trace_show and candleSet.candles.size() > 0
Candle candle = candleSet.candles.ﬁrst()
if bar_index - candle.o_idx < 5000
bin.lines.push(line.new(candle.o_idx, candle.o, candle.candle_left, candle.o,
color = settings.trace_o_color, style = LineStyle(settings.trace_o_style), width =
settings.trace_o_size))
