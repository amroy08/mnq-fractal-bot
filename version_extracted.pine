method CalculatePositions(CandleSet candleSet, int ohset) =>
size = candleSet.candles.size()
if size > 0
for i = size - 1 to 0 by 1
Candle candle = candleSet.candles.get(i)
t_buher = ohset + (settings.width + 1) * (size - i - 1)
candle.candle_left := bar_index + t_buher
candle.candle_right := bar_index + settings.width + t_buher
candle.wick_x := bar_index + settings.width / 2 + t_buher
candleSet

method DrawCandles(CandleSet candleSet) =>
for [i, candle] in candleSet.candles
bull = candle.c > candle.o
// Draw body
bin.boxes.push(box.new(candle.candle_left, math.max(candle.o, candle.c),
candle.candle_right, math.min(candle.o, candle.c), bull ? settings.bull_border :
settings.bear_border, 1, bgcolor = bull ? settings.bull_body : settings.bear_body))
// Draw wicks
bin.lines.push(line.new(candle.wick_x, candle.h, candle.wick_x,
math.max(candle.o, candle.c), color = bull ? settings.bull_wick : settings.bear_wick))
bin.lines.push(line.new(candle.wick_x, math.min(candle.o, candle.c),
candle.wick_x, candle.l, color = bull ? settings.bull_wick : settings.bear_wick))
// Draw interval value label based on position setting
if settings.daily_name and candle.dow != ''
if settings.dow_position == 'Both' or settings.dow_position == 'Top'
bin.labels.push(label.new(candle.wick_x, candle.h, candle.dow, color =
color_transparent, textcolor = settings.dow_color, style = label.style_label_down, size =
settings.dow_size))
if settings.dow_position == 'Both' or settings.dow_position == 'Bottom'
bin.labels.push(label.new(candle.wick_x, candle.l, candle.dow, color =
color_transparent, textcolor = settings.dow_color, style = label.style_label_up, size =
settings.dow_size))
candleSet

